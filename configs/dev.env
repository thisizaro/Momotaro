# Local development profile (docs/PHASE3_IMPLEMENTATION.md Unit H). For a
# developer manually submitting a handful of test records and reading the
# actual LLM rationale, not for a batch run. Layer on top of a real .env
# rather than replacing it:
#   set -a && source configs/dev.env && set +a
#
# Real time: a developer stepping through a record by hand does not need
# cooldowns compressed.
DEMO_TIME_SCALE=1

# The live provider chain, same as demo: Groq primary, Gemini automatic
# failover, rules the guaranteed terminal rung.
LLM_PROVIDER_CHAIN=groq,gemini,rules

# Every record sampled: at manual, single-digit-record volume this stays
# far under Groq's 30 RPM free tier, and seeing a live rationale on every
# submitted record is the point. Do NOT use this value for a demo-sized
# batch (docs/PHASE3_IMPLEMENTATION.md Unit H); see configs/demo.env.
LLM_SAMPLE_RATE=1.0
