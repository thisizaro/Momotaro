# Demo profile (docs/PHASE3_IMPLEMENTATION.md Unit H). Sets the existing
# individually named knobs a live PRD.md section 12 run needs; the code
# never learns what "demo" means, it just reads these variables. Layer on
# top of a real .env rather than replacing it:
#   set -a && source configs/demo.env && set +a
#
# DEMO_TIME_SCALE compresses every wall-clock wait (retry cooldowns, contact
# cooldowns, the salary-window retry, the recovery window) so a multi-day
# recovery cycle finishes in seconds (docs/ARCHITECTURE.md section 17).
# 300000 matches what the e2e harness already runs at
# (test/e2e/walking_skeleton_test.go), a value already proven safe.
DEMO_TIME_SCALE=300000

# The live provider chain: Groq primary, Gemini automatic failover, rules
# the guaranteed terminal rung (docs/DECISIONS.md 2026-08-28).
LLM_PROVIDER_CHAIN=groq,gemini,rules

# 0.15 selects ~15 records out of a 100-record batch for a live model call,
# comfortably under Groq's 30 RPM free tier: real rationales, no forced
# failover. Raise to 0.5 to deliberately trip the real rate limit and stage
# a genuine on-stage failover to Gemini, then rules, with real
# rate_limited hops in the audit trail (docs/PHASE3_IMPLEMENTATION.md Unit
# H) instead of a simulated outage.
LLM_SAMPLE_RATE=0.15
