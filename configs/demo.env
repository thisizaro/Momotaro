# Demo profile (docs/PHASE3_IMPLEMENTATION.md Unit H). Sets the existing
# individually named knobs a live PRD.md section 12 run needs; the code
# never learns what "demo" means, it just reads these variables.
#
# Apply it with make's PROFILE variable, which layers this file on top of
# .env:
#
#   make run-decision-engine PROFILE=demo
#   make demo-up PROFILE=demo
#
# Do NOT `source` this file. It looks like it works and does nothing: the
# Makefile's own `include .env` outranks the environment, so a sourced value
# is silently discarded on every run-* target. That is why every demo run
# before 2026-08-31 used real-time waits and no LLM chain
# (docs/INCIDENTS.md 2026-08-31).

# DEMO_TIME_SCALE compresses the wall-clock waits we schedule: retry delays,
# contact cooldowns, the salary-window retry, the mandate lead time. A
# multi-day recovery cycle then finishes in seconds
# (docs/ARCHITECTURE.md section 17). 300000 matches what the e2e harness
# already runs at (test/e2e/walking_skeleton_test.go).
#
# It deliberately does NOT compress RECOVERY_WINDOW, which is compared
# against a record's real elapsed age rather than waited out. Scaling that
# one made the window (2.016s) shorter than the pipeline's own processing
# latency and escalated 73 of 100 records before they were ever priced. See
# services/decision-engine/cmd/main.go's guardrailsFrom.
DEMO_TIME_SCALE=300000

# Groq primary, rules the guaranteed terminal rung.
#
# Gemini is deliberately NOT in this chain, per the measurements in
# docs/DECISIONS.md 2026-08-28: Groq p50 ~570ms against Gemini p50 3.01s,
# and no single LLM_TIMEOUT serves both inside the Decision Engine's 5s
# CALL_TIMEOUT. This file previously said groq,gemini,rules, contradicting
# that decision, and a live 100-record run on 2026-08-31 confirmed the
# measurement the hard way: `groq:circuit_open,gemini:timeout,rules:ok`
# appeared six times in the audit trail, i.e. Gemini cost a full timeout and
# answered nothing.
#
# The Gemini rung is built, unit-tested and confirmed working against the
# live API; re-enabling it honestly needs per-rung timeouts, which is
# tracked in docs/BACKLOG.md. Until then, adding it here only buys latency.
LLM_PROVIDER_CHAIN=groq,rules

# 0.15 selects ~15 records out of a 100-record batch for a live model call.
# Note this is under Groq's 30 RPM free tier only on paper: a seeded batch is
# consumed in a couple of seconds, so ~15 calls can arrive inside one second
# and still trip the limit. That is not a misconfiguration to fix, it is the
# circuit breaker doing its job, and it produces genuine `rate_limited` hops
# in the audit trail. Raise to 0.5 to make that failover certain rather than
# likely, for a deliberate on-stage demonstration
# (docs/PHASE3_IMPLEMENTATION.md Unit H).
LLM_SAMPLE_RATE=0.15
