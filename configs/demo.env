# Demo profile (docs/PHASE3_IMPLEMENTATION.md Unit H). Sets the existing
# individually named knobs a live PRD.md section 12 run needs; the code
# never learns what "demo" means, it just reads these variables.
#
# Apply it with make's PROFILE variable, which layers this file on top of
# .env:
#
#   make run-decision-engine PROFILE=demo
#   make demo-up PROFILE=demo
#
# Do NOT `source` this file. It looks like it works and does nothing: the
# Makefile's own `include .env` outranks the environment, so a sourced value
# is silently discarded on every run-* target. That is why every demo run
# before 2026-08-31 used real-time waits and no LLM chain
# (docs/INCIDENTS.md 2026-08-31).

# DEMO_TIME_SCALE compresses the wall-clock waits we schedule: retry delays,
# contact cooldowns, the salary-window retry, the mandate lead time. A
# multi-day recovery cycle then finishes in seconds
# (docs/ARCHITECTURE.md section 17). 300000 matches what the e2e harness
# already runs at (test/e2e/walking_skeleton_test.go).
#
# It deliberately does NOT compress RECOVERY_WINDOW, which is compared
# against a record's real elapsed age rather than waited out. Scaling that
# one made the window (2.016s) shorter than the pipeline's own processing
# latency and escalated 73 of 100 records before they were ever priced. See
# services/decision-engine/cmd/main.go's guardrailsFrom.
DEMO_TIME_SCALE=300000

# Groq primary, rules the guaranteed terminal rung.
#
# Gemini is deliberately NOT in this chain, per the measurements in
# docs/DECISIONS.md 2026-08-28: Groq p50 ~570ms against Gemini p50 3.01s,
# and no single LLM_TIMEOUT serves both inside the Decision Engine's 5s
# CALL_TIMEOUT. This file previously said groq,gemini,rules, contradicting
# that decision, and a live 100-record run on 2026-08-31 confirmed the
# measurement the hard way: `groq:circuit_open,gemini:timeout,rules:ok`
# appeared six times in the audit trail, i.e. Gemini cost a full timeout and
# answered nothing.
#
# The Gemini rung is built, unit-tested and confirmed working against the
# live API; re-enabling it honestly needs per-rung timeouts, which is
# tracked in docs/BACKLOG.md. Until then, adding it here only buys latency.
LLM_PROVIDER_CHAIN=groq,rules

# LLM_ROUTE_CONFIDENCE_THRESHOLD decides WHICH records are ambiguous enough
# to be worth a live model call (docs/DEMO_READINESS.md Unit AI,
# docs/ARCHITECTURE.md section 17: "route by ambiguity, call the model when
# the deterministic table is not confident"). The Decision Engine asks the
# rules engine first, for free (it does no I/O and cannot fail), and only
# offers the record to a live model when that answer's own confidence is
# below this number.
#
# 0.80 was chosen by reading rules/actions.go's actual confidence table
# rather than picking a round number: TRANSIENT_BANK (0.90), HARD_DECLINE
# (0.85), INSUFFICIENT_FUNDS and ABANDONMENT (0.80 each), and RISK_HOLD
# (1.00, a safety call that is never sampled anyway, see
# CLASSIFY_CONFIDENCE_THRESHOLD below) stay rules-only at this threshold:
# the rail told us plainly what happened. USER_ACTION_NEEDED (0.70, the
# broadest bucket by the table's own comment), OVERDUE (0.75, no technical
# failure to point at) and the unknown-code path (0.00) are the genuinely
# ambiguous cases this threshold sends to a live model, budget permitting.
# Set to 0.0 (the code default if this line is ever removed) to route
# nothing to a live model at all.
LLM_ROUTE_CONFIDENCE_THRESHOLD=0.80

# LLM_SAMPLE_RATE is a CEILING, not a selector (docs/DEMO_READINESS.md Unit
# AI; before this it was Phase 3 Unit H's hash-of-record-id sample, which
# picked a random 15% regardless of whether a record needed the model at
# all). 0.15 now bounds the running fraction of every classified record
# that is ever allowed a live call, however many the threshold above judges
# ambiguous: if a batch turns out mostly ambiguous, only the earliest ~15%
# of it get the model, and every later ambiguous record still gets a real
# answer, just from the rules table.
#
# This is still under Groq's 30 RPM free tier only on paper: a seeded batch
# is consumed in a couple of seconds, so ~15 calls can arrive inside one
# second and still trip the limit. That is not a misconfiguration to fix,
# it is the circuit breaker doing its job, and it produces genuine
# `rate_limited` hops in the audit trail, now surfaced on the batch report
# as llm_quota_exhausted_count rather than silently absorbed. Raise to 0.5
# to make that failover certain rather than likely, for a deliberate
# on-stage demonstration (docs/PHASE3_IMPLEMENTATION.md Unit H).
LLM_SAMPLE_RATE=0.15

# The /v1/demo/* control surface (docs/PHASE5_5_IMPLEMENTATION.md Unit W):
# batch seeding with scenario presets, World Simulator state, poison
# injection. Off by default everywhere else, because these routes do not
# exist in a production deployment and the flag is what makes that claim
# true rather than merely stated. On here because this profile exists for
# exactly one purpose, and a demo that still needs a terminal to seed a
# batch has not solved the problem Unit W was built to solve.
#
# Requires WORLD_SIMULATOR_ADDR, which the api-gateway validates at startup
# and which make run-api-gateway already sets.
DEMO_CONTROLS_ENABLED=true

# The live WebSocket route (GET /v1/batches/{batch_id}/live) 403s every
# handshake by default once the caller is cross-origin, which is
# github.com/coder/websocket's own same-origin-only default, not something
# this codebase opted into. In this profile it always is cross-origin: the
# dashboard runs on the Vite dev server at :5173 (CLAUDE.md, `cd web && npm
# run dev`) while the Gateway listens on :8090, two different origins by the
# handshake's own definition even though both are localhost. Unset, the
# socket looked "connected" in the demo checklist but every real browser
# handshake failed before reaching liveUpdates, so the scrolling live-event
# log never received a single message in any dev or demo run.
#
# Off by default everywhere else (.env.example): a production deployment
# normally serves the dashboard and the Gateway from the same origin behind
# one reverse proxy, so nothing needs adding there, and an unset value keeps
# the Gateway exactly as restrictive as it already is. On here because this
# profile exists for exactly the setup where they differ.
WS_ALLOWED_ORIGINS=http://localhost:5173
