# Copy to .env.local for local overrides. Both are gitignored.
#
# With VITE_API_BASE_URL unset, the dashboard runs entirely on the built-in
# mock engine (src/lib/mockEngine.ts). That is deliberate: the UI can be
# developed and demoed before the API Gateway exists, and it is why this app
# renders with no backend running at all.
#
# Once the Gateway is up, point this at it and the same code paths hit real
# endpoints instead. See docs/API_GATEWAY.md for the contract.
# VITE_API_BASE_URL=http://localhost:8090

# Static shared key sent as X-API-Key. Matches API_KEY in the root
# .env.example (docs/ARCHITECTURE.md section 17).
VITE_API_KEY=momotaro-demo-key

# Force mocks even when a base URL is set. Useful for UI work while the
# backend is mid-change.
# VITE_USE_MOCK=true
