# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every service validates these at startup and exits non-zero if any required
# value is missing or malformed (docs/ENGINEERING.md section 5).

ENV=local
LOG_LEVEL=info

# Ports are per-service; these are defaults for running one at a time.
GRPC_PORT=9090
METRICS_PORT=9091

POSTGRES_DSN=postgres://momotaro:momotaro@localhost:5432/momotaro?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092

# Compresses every wall-clock wait so a live demo finishes in minutes rather
# than hours. 1 is real time. 3600 turns an hour-long cooldown into a second.
# See docs/ARCHITECTURE.md section 17.
DEMO_TIME_SCALE=1

# API Gateway. Static shared key, deliberately not real user auth, so a judge
# can try the API with zero setup (ARCHITECTURE.md section 17). Not a secret
# in any meaningful sense; replace before this is ever public.
API_KEY=momotaro-demo-key

# LLM provider chain, tried in order, ending in the deterministic rules
# fallback. Provider choice is deliberately still open pending cost
# evaluation, so leave keys blank to run rules-only at zero cost.
LLM_PROVIDER_CHAIN=rules
LLM_TIMEOUT=2s
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
