# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every service validates these at startup and exits non-zero if any required
# value is missing or malformed (docs/ENGINEERING.md section 5).

ENV=local
LOG_LEVEL=info

# Ports are per-service; these are defaults for running one at a time.
GRPC_PORT=9090
METRICS_PORT=9091

POSTGRES_DSN=postgres://momotaro:momotaro@localhost:5432/momotaro?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092

# Compresses every wall-clock wait so a live demo finishes in minutes rather
# than hours. 1 is real time. 3600 turns an hour-long cooldown into a second.
# See docs/ARCHITECTURE.md section 17.
DEMO_TIME_SCALE=1

# API Gateway. Static shared key, deliberately not real user auth, so a judge
# can try the API with zero setup (ARCHITECTURE.md section 17). Not a secret
# in any meaningful sense; replace before this is ever public.
API_KEY=momotaro-demo-key

# API Gateway's own HTTP listener (separate from GRPC_PORT/METRICS_PORT,
# which are internal gRPC).
HTTP_PORT=8090

# Service-to-service addresses. Only needed by the services that dial them;
# each one fails fast at startup if its own required address is missing.
INGESTION_ADDR=localhost:9090
CLASSIFIER_ADDR=localhost:9090
EXECUTOR_ADDR=localhost:9090

# Bounds every outbound gRPC call (ENGINEERING.md section 3: no unbounded
# outbound call).
CALL_TIMEOUT=5s

# API Gateway's basic rate limit: a single token bucket shared across every
# caller, since this system has no per-user identity to key on (section 17).
# Either value <= 0 disables limiting entirely.
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Overrides for the raw.events topic/consumer group. Leave unset in normal
# use; only the walking-skeleton integration test sets these, to an isolated
# scratch topic, so it cannot replay unrelated messages left behind by other
# test runs (see DECISIONS.md and INCIDENTS.md).
RAW_EVENTS_TOPIC=raw.events
RAW_EVENTS_CONSUMER_GROUP=decision-engine
RAW_EVENTS_DLQ_TOPIC=raw.events.dlq

# Decision Engine's keyed worker pool size (ARCHITECTURE.md section 8a):
# how many records it processes concurrently, dispatched by hash(record_id).
WORKER_POOL_SIZE=32

# Phase 1 placeholders for the cause-aware retry timing ARCHITECTURE.md
# section 5a describes (salary window for insufficient_funds, short backoff
# for bank_timeout, etc); that policy is Phase 2 work. One fixed delay per
# action family for now, scaled by DEMO_TIME_SCALE like every other
# wall-clock wait.
RETRY_DELAY=30s
NUDGE_DELAY=30s

# How often the scheduler worker polls RECORD_STATE for due records
# (ARCHITECTURE.md section 7a). Also scaled by DEMO_TIME_SCALE.
SCHEDULER_POLL_INTERVAL=2s

# Guardrails: the hard stopping rules from PRD.md section 11. These are
# compliance and asset-protection limits, not tuning knobs: MAX_RETRIES
# mirrors NPCI-style mandate debit limits, and capping retries also protects
# the merchant's authorization rate with issuers, since hammering a card with
# retries degrades approvals on future legitimate payments.
#
# Enforced inside the same Postgres transaction as the state change they gate,
# never from a cache, because a cap that falls through when its store is
# unreachable is not a cap (DECISIONS.md 2026-08-24).
#
# Zero stopping-rule violations is a headline metric (PRD.md section 9), so
# raising these is a product decision, not a performance one.
# The checked-in economics the scorer prices actions with. Files rather than
# compiled-in constants so the numbers can be read and argued with. The service
# refuses to start if they are missing or unparseable; see DECISIONS.md.
# Container images copy configs/ to /configs, so override these there.
INTERVENTION_COSTS_PATH=configs/intervention_costs.yaml
RECOVERY_PRIORS_PATH=configs/recovery_priors.yaml

MAX_RETRIES=3
MAX_CONTACTS=3
# Minimum gap between two customer contacts, and the age past which a record
# is no longer worth acting on at all. Both scaled by DEMO_TIME_SCALE, or a
# 7 day window would never close inside a demo.
CONTACT_COOLDOWN=24h
RECOVERY_WINDOW=168h

# How long after a nudge goes out the Executor reports the customer's answer
# is expected, i.e. ExecuteResponse.resolves_at. Real customers take hours
# (ARCHITECTURE.md section 17); this is the demo value, and it is scaled by
# DEMO_TIME_SCALE like every other wall-clock wait. Nothing consumes it yet:
# the delayed-outcome callback that will act on it is Phase 5.
NUDGE_RESOLVE_DELAY=2m

# The shared BATCH row that ungrouped Ingestion.SubmitEvent calls (the
# production webhook path) attach to, so every record stays reportable
# without a demo/backfill batch of its own. Leave unset in normal use; tests
# override it so they don't share, and pollute, the production rolling
# batch (see DECISIONS.md).
ROLLING_BATCH_SOURCE=webhook

# Audit's continuous invariant verifier (services/audit/internal/server/
# watch.go) re-checks every batch on this interval, independent of any
# GetRecordAudit/VerifyInvariants caller (ARCHITECTURE.md section 10a).
INVARIANT_CHECK_INTERVAL=1m

# LLM provider chain, tried in order, always ending in the deterministic
# rules fallback. The chain refuses to start unless "rules" is present and
# last: it is the only rung that cannot fail, so it is what makes the chain
# always terminate in a valid answer.
#
# The default stays rules-only on purpose. It costs nothing, makes no outbound
# call, and keeps the whole test suite free. The live chain
# (groq,gemini,rules, see docs/DECISIONS.md 2026-08-28) is opt-in, because the
# free tiers are capped per day and one accidental test loop against a live
# chain burns the day's quota.
LLM_PROVIDER_CHAIN=rules

# Per-rung cap for any non-terminal rung. MEASURED against Groq
# gpt-oss-20b at reasoning_effort:low over 16 live calls: min 237ms,
# p50 ~570ms, max 688ms. 2s is about three times the observed max.
# Does NOT fit Gemini (p50 3.0s, max 6.19s), which is why the default chain
# is groq,rules rather than groq,gemini,rules. See docs/DECISIONS.md.
LLM_TIMEOUT=2s

# Held back from the caller's deadline so the terminal rules rung and the
# response marshal always fit inside it, however badly the rungs above behave.
# Without it, two rungs that each burn LLM_TIMEOUT can consume a 5s
# CALL_TIMEOUT entirely and the correct answer arrives after the caller has
# given up, which the Decision Engine treats as a failure and dead-letters.
# See services/classifier/internal/provider/budget.go.
CHAIN_RESERVE=150ms

# Groq is the primary rung: the only provider evaluated that offers guaranteed
# constrained decoding (json_schema with strict:true is token-level, so the
# model cannot emit a bucket outside the enum), and the fastest inference
# available. Only gpt-oss-20b, gpt-oss-120b and Qwen 3.8 27B support strict
# mode; everything else on Groq is best effort, so changing GROQ_MODEL is a
# decision, not a tweak. Free tier: 30 RPM and 1,000 requests/day, org-wide.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Gemini is the automatic failover, on native generateContent. Deliberately
# NOT the OpenAI-compatibility endpoint at /v1beta/openai: that exists, but its
# tool calling does not follow the OpenAI schema, and structured output is the
# one thing a fallback rung must not get wrong. Free tier: 10 to 15 RPM.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Retired by docs/DECISIONS.md 2026-08-28: the chain is groq,gemini,rules.
# Kept blank rather than deleted so an existing local .env does not break.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
