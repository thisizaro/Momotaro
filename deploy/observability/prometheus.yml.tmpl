# Local-dev scrape config template (docs/PHASE4_IMPLEMENTATION.md Unit C).
# `make up-observability` renders this into prometheus.generated.yml
# (gitignored), substituting HOST_IP_PLACEHOLDER for $(HOST_IP) -- see the
# Makefile comment above the `run-<service>` targets for why this is a
# substitution rather than a literal `host.docker.internal`
# (docs/INCIDENTS.md 2026-08-29: on this stack's actual Docker Desktop +
# WSL2 setup, host.docker.internal resolves to Docker Desktop's own
# internal VM, not the WSL2 distro make run-<service> binds ports on, so
# the default only works on setups where that alias is accurate).
#
# App services are not containers on the docker-compose network (see that
# file's own header comment). Phase 7's k8s deployment gets its own scrape
# config via service discovery, not this file.
global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: ingestion
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9091"]
  - job_name: classifier
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9191"]
  - job_name: executor
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9193"]
  - job_name: audit
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9195"]
  - job_name: decision-engine
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9197"]
  - job_name: api-gateway
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9199"]
  - job_name: reporting
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9201"]
  - job_name: world-simulator
    static_configs:
      - targets: ["HOST_IP_PLACEHOLDER:9203"]
