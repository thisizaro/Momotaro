{
  "title": "Momotaro: Service Health",
  "uid": "momotaro-service-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(requests_total, job)", "refId": "job" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate, by method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(requests_total{job=~\"$job\"}[$__rate_interval])) by (job, method)",
          "legendFormat": "{{job}} {{method}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate, by method and code (non-OK)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(requests_total{job=~\"$job\", code!=\"OK\"}[$__rate_interval])) by (job, method, code)",
          "legendFormat": "{{job}} {{method}} {{code}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency, by method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, job, method))",
          "legendFormat": "{{job}} {{method}}"
        }
      ]
    }
  ]
}
